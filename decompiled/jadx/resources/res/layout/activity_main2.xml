        android:id="@+id/servo_button"
        android:background="@drawable/servo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="@+id/watering_button"
        app:layout_constraintStart_toStartOf="@+id/led_button"
        app:layout_constraintTop_toBottomOf="@+id/led_button"/>
    <Button
        android:id="@+id/watering_button"
        android:background="@drawable/watering"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="20dp"
